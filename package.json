{
  "name": "album-studio",
  "version": "0.2.0",
  "private": true,
  "description": "本地摄影相册与社交作品排版工具",
  "main": "./out/main/index.js",
  "author": "Album Studio",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "exifr": "^7.1.3",
    "fontkit": "^2.0.4",
    "konva": "^10.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.2.7",
    "sharp": "^0.35.4",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.albumstudio.desktop",
    "productName": "相册工作台",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Album-Studio-${version}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "electronDist": "node_modules/electron/dist"
  }
}
